{{!--
  entity-merge-patch.hbs — emitted once per entity when merge-patch-style is "typed".

  Generates a concrete, non-generic RFC 7396 JSON Merge Patch container class
  named {ModelName}MergePatchUpdate (e.g. WidgetMergePatchUpdate for Widget).

  Override via tspconfig.yaml:
    options:
      "@massivescale/tsp-aspnetcore-api":
        templates:
          entity-merge-patch: "./templates/entity-merge-patch.hbs"

  ── Template variables ──────────────────────────────────────────────────────
  modelName            — C# class name of the target entity (e.g. "Widget")
  qualifiedModelName   — Fully-qualified C# type (e.g. "Demo.Models.Widget")
--}}
/// <summary>
/// RFC 7396 JSON Merge Patch container for <see cref="{{{qualifiedModelName}}}"/>.
/// Captures all properties sent by the client; use <see cref="IsDefined"/> to
/// distinguish "field absent from the request" from "field explicitly set to null".
/// </summary>
[System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage]
public class {{{modelName}}}MergePatchUpdate
{
    /// <summary>
    /// Raw JSON properties received in the patch payload, keyed by property name.
    /// Populated automatically by <c>System.Text.Json</c> via <c>[JsonExtensionData]</c>.
    /// </summary>
    [JsonExtensionData]
    public Dictionary<string, JsonElement> Properties { get; init; } = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Returns <see langword="true"/> if <paramref name="propertyName"/> was explicitly
    /// included in the patch payload (even if its value is <see langword="null"/>).
    /// </summary>
    public bool IsDefined(string propertyName) =>
        Properties.ContainsKey(propertyName);

    /// <summary>
    /// Returns <see langword="true"/> if <paramref name="propertyName"/> is present in the
    /// patch and its JSON value is <c>null</c> (RFC 7396 "clear field" signal).
    /// </summary>
    public bool IsNull(string propertyName) =>
        Properties.TryGetValue(propertyName, out var el) && el.ValueKind == JsonValueKind.Null;

    /// <summary>
    /// Returns the string value of <paramref name="propertyName"/>, or
    /// <see langword="null"/> when the property is absent or its JSON value is null.
    /// </summary>
    public string? GetString(string propertyName)
    {
        if (!Properties.TryGetValue(propertyName, out var element)) return null;
        if (element.ValueKind == JsonValueKind.Null) return null;
        return element.ValueKind == JsonValueKind.String ? element.GetString() : element.ToString();
    }

    /// <summary>
    /// Attempts to deserialize <paramref name="propertyName"/> to <typeparamref name="TValue"/>.
    /// Returns <see langword="true"/> when the property is present (even if null);
    /// <see langword="false"/> when it is absent or cannot be deserialized.
    /// </summary>
    public bool TryGetValue<TValue>(string propertyName, out TValue? value, JsonSerializerOptions? options = null)
    {
        value = default;
        if (!Properties.TryGetValue(propertyName, out var element)) return false;
        if (element.ValueKind == JsonValueKind.Null) return true;
        try
        {
            value = JsonSerializer.Deserialize<TValue>(element.GetRawText(), options);
            return true;
        }
        catch
        {
            return false;
        }
    }

    /// <summary>Returns the names of all properties explicitly provided in this patch.</summary>
    public IEnumerable<string> DefinedProperties => Properties.Keys;

    /// <summary>
    /// Returns the names of all properties that have been modified (i.e. explicitly
    /// provided) in this patch.
    /// </summary>
    public IEnumerable<string> GetChangedPropertyNames() => Properties.Keys;

    /// <summary>
    /// Attempts to get the declared <see cref="Type"/> of the property named
    /// <paramref name="name"/> on <see cref="{{{qualifiedModelName}}}"/>.
    /// Returns <see langword="false"/> when no matching public instance property exists.
    /// </summary>
    public bool TryGetPropertyType(string name, out Type? type)
    {
        var prop = FindProperty(name);
        type = prop?.PropertyType;
        return prop is not null;
    }

    /// <summary>
    /// Attempts to get the patch value for the property named <paramref name="name"/>,
    /// deserialized to the declared property type on <see cref="{{{qualifiedModelName}}}"/>.
    /// Returns <see langword="false"/> when the property is absent from the patch,
    /// <see cref="{{{qualifiedModelName}}}"/> declares no such property, or deserialization fails.
    /// </summary>
    public bool TryGetPropertyValue(string name, out object? value, JsonSerializerOptions? options = null)
    {
        value = null;
        if (!Properties.TryGetValue(name, out var element)) return false;
        var prop = FindProperty(name);
        if (prop is null) return false;
        if (element.ValueKind == JsonValueKind.Null) return true;
        try
        {
            value = JsonSerializer.Deserialize(element.GetRawText(), prop.PropertyType, options);
            return true;
        }
        catch
        {
            return false;
        }
    }

    /// <summary>
    /// Serializes <paramref name="value"/> and stores it as a patch entry for the
    /// property named <paramref name="name"/>. Pass <see langword="null"/> to mark
    /// the field for clearing (RFC 7396 semantics).
    /// Returns <see langword="false"/> when serialization fails.
    /// </summary>
    public bool TrySetPropertyValue(string name, object? value, JsonSerializerOptions? options = null)
    {
        try
        {
            using var doc = JsonDocument.Parse(JsonSerializer.Serialize(value, options));
            Properties[name] = doc.RootElement.Clone();
            return true;
        }
        catch
        {
            return false;
        }
    }

    /// <summary>
    /// Constructs a <see cref="{{{modelName}}}MergePatchUpdate"/> from a JSON string, treating every
    /// property present in the JSON as explicitly defined in the patch.
    /// </summary>
    /// <remarks>
    /// Properties are keyed by their JSON wire names. If <see cref="{{{qualifiedModelName}}}"/> uses
    /// <c>[JsonPropertyName]</c> attributes or a custom <see cref="JsonSerializerOptions"/>
    /// naming policy, the keys in <see cref="Properties"/> will reflect those wire names
    /// and may not match C# property names used by <see cref="Patch({{{qualifiedModelName}}}, JsonSerializerOptions?)"/>.
    /// </remarks>
    public static {{{modelName}}}MergePatchUpdate FromJson(string json, JsonSerializerOptions? options = null) =>
        JsonSerializer.Deserialize<{{{modelName}}}MergePatchUpdate>(json, options) ?? new {{{modelName}}}MergePatchUpdate();

    /// <summary>
    /// Constructs a <see cref="{{{modelName}}}MergePatchUpdate"/> from an existing
    /// <see cref="{{{qualifiedModelName}}}"/> instance by serializing it to JSON.
    /// Every property that is included in the serialized output is treated as explicitly
    /// defined in the patch.
    /// </summary>
    /// <remarks>
    /// Serialization honours <paramref name="options"/> (including
    /// <c>DefaultIgnoreCondition</c>). Pass <see langword="null"/> options to include all
    /// properties, even those with <see langword="null"/> values.
    /// </remarks>
    public static {{{modelName}}}MergePatchUpdate From({{{qualifiedModelName}}} entity, JsonSerializerOptions? options = null) =>
        FromJson(JsonSerializer.Serialize(entity, options), options);

    /// <summary>
    /// Applies defined properties recursively to <paramref name="original"/> in place.
    /// Use <see cref="TryPatch"/> when rejected-path diagnostics are needed.
    /// </summary>
    public void Patch({{{qualifiedModelName}}} original, JsonSerializerOptions? options = null)
    {
        TryPatch(original, out _, options);
    }

    /// <summary>
    /// Applies each defined patch property recursively to <paramref name="original"/>.
    /// Invalid, unknown, and read-only properties are reported and skipped; valid
    /// sibling properties are still applied. The root instance is never replaced.
    /// </summary>
    /// <param name="original">The entity to mutate.</param>
    /// <param name="rejectedPaths">JSON property paths that could not be applied.</param>
    /// <param name="options">Serializer options used for the entity and patch values.</param>
    /// <returns><see langword="true"/> when every supplied property was applied.</returns>
    public bool TryPatch({{{qualifiedModelName}}} original, out IReadOnlyList<string> rejectedPaths, JsonSerializerOptions? options = null)
    {
        var rejected = new List<string>();
        rejectedPaths = rejected;
        if (original is null)
        {
            rejected.Add("$");
            return false;
        }

        var entries = new List<PatchEntry>();
        foreach (var (name, element) in Properties)
        {
            var prop = FindProperty(name);
            if (prop is null || !prop.CanWrite)
            {
                rejected.Add(name);
                continue;
            }
            entries.Add(new PatchEntry(prop, name, element));
        }
        if (entries.Count == 0) return rejected.Count == 0;

        // One serialize/merge/deserialize round trip applies every property. Only when
        // that fails is each property retried alone, so one bad value cannot block its
        // valid siblings and the failing path can be reported.
        var batchRejected = new List<string>();
        if (TryApply(original, entries, batchRejected, options, out _))
        {
            rejected.AddRange(batchRejected);
            return rejected.Count == 0;
        }

        foreach (var entry in entries)
        {
            if (!TryApply(original, new[] { entry }, rejected, options, out var failedPath))
            {
                rejected.Add(failedPath ?? entry.Name);
            }
        }

        return rejected.Count == 0;
    }

    private readonly record struct PatchEntry(PropertyInfo Property, string Name, JsonElement Value);

    /// <summary>
    /// Merges <paramref name="entries"/> into a JSON copy of <paramref name="original"/>,
    /// deserializes the result, and copies the patched properties back. Nested paths
    /// that cannot be merged are added to <paramref name="rejected"/>. On failure nothing
    /// is copied and <paramref name="failedPath"/> holds the JSON path of the bad value
    /// when the serializer reported one.
    /// </summary>
    private static bool TryApply({{{qualifiedModelName}}} original, IReadOnlyList<PatchEntry> entries, List<string> rejected, JsonSerializerOptions? options, out string? failedPath)
    {
        failedPath = null;
        try
        {
            if (JsonSerializer.SerializeToNode(original, options) is not JsonObject target) return false;

            var patch = new JsonObject();
            foreach (var entry in entries)
            {
                patch[entry.Name] = JsonNode.Parse(entry.Value.GetRawText());
            }
            MergeObject(target, patch, typeof({{{qualifiedModelName}}}), rejected, string.Empty);

            var updated = target.Deserialize<{{{qualifiedModelName}}}>(options);
            if (updated is null) return false;
            foreach (var entry in entries)
            {
                entry.Property.SetValue(original, entry.Property.GetValue(updated));
            }
            return true;
        }
        catch (JsonException ex)
        {
            var path = ex.Path;
            failedPath = path is { Length: > 1 } && path.StartsWith("$.", StringComparison.Ordinal)
                ? path[2..]
                : path is { Length: > 1 } && path[0] == '$'
                    ? path[1..]
                    : null;
            return false;
        }
        catch
        {
            return false;
        }
    }

    /// <summary>
    /// Applies RFC 7396 merge rules from <paramref name="patch"/> onto <paramref name="target"/>.
    /// Keys of a CLR model must match one of its properties; keys of a dictionary or a
    /// free-form JSON value (<see cref="JsonElement"/>, <see cref="JsonNode"/>, <see cref="object"/>)
    /// are data, so any key is accepted and matched exactly.
    /// </summary>
    private static void MergeObject(JsonObject target, JsonObject patch, Type targetType, List<string> rejected, string prefix)
    {
        var openValueType = GetOpenObjectValueType(targetType);
        foreach (var (patchName, patchValue) in patch)
        {
            string wireName;
            Type childType;
            if (openValueType is not null)
            {
                wireName = patchName;
                childType = openValueType;
            }
            else
            {
                var member = FindMember(targetType, patchName);
                if (member is null)
                {
                    rejected.Add(prefix.Length == 0 ? patchName : $"{prefix}.{patchName}");
                    continue;
                }
                wireName = member.Value.WireName;
                childType = member.Value.Property.PropertyType;
            }
            var path = prefix.Length == 0 ? wireName : $"{prefix}.{wireName}";

            var comparison = openValueType is null ? StringComparison.OrdinalIgnoreCase : StringComparison.Ordinal;
            string? targetName = null;
            foreach (var targetEntry in target)
            {
                if (string.Equals(targetEntry.Key, wireName, comparison))
                {
                    targetName = targetEntry.Key;
                    break;
                }
            }
            if (patchValue is null)
            {
                if (targetName is not null) target.Remove(targetName);
                continue;
            }

            if (patchValue is JsonObject patchChild)
            {
                if (targetName is not null && target[targetName] is JsonObject existingChild)
                {
                    MergeObject(existingChild, patchChild, childType, rejected, path);
                }
                else
                {
                    var targetChild = new JsonObject();
                    MergeObject(targetChild, patchChild, childType, rejected, path);
                    target[targetName ?? wireName] = targetChild;
                }
                continue;
            }

            target[targetName ?? wireName] = patchValue.DeepClone();
        }
    }

    /// <summary>
    /// Returns the value type of an object whose keys are data rather than CLR properties:
    /// <c>TValue</c> for a string-keyed dictionary, <see cref="object"/> for a free-form
    /// JSON value. Returns <see langword="null"/> for a regular model type.
    /// </summary>
    private static Type? GetOpenObjectValueType(Type type)
    {
        type = Nullable.GetUnderlyingType(type) ?? type;
        if (type == typeof(object) || type == typeof(JsonElement) || typeof(JsonNode).IsAssignableFrom(type))
        {
            return typeof(object);
        }
        if (TryGetStringKeyedValueType(type, out var valueType)) return valueType;
        foreach (var candidate in type.GetInterfaces())
        {
            if (TryGetStringKeyedValueType(candidate, out valueType)) return valueType;
        }
        return null;
    }

    private static bool TryGetStringKeyedValueType(Type type, out Type? valueType)
    {
        valueType = null;
        if (!type.IsGenericType) return false;
        var definition = type.GetGenericTypeDefinition();
        if (definition != typeof(IDictionary<,>) && definition != typeof(IReadOnlyDictionary<,>)) return false;
        var arguments = type.GetGenericArguments();
        if (arguments[0] != typeof(string)) return false;
        valueType = arguments[1];
        return true;
    }

    /// <summary>
    /// Asynchronous variant of <see cref="Patch({{{qualifiedModelName}}}, JsonSerializerOptions?)"/>.
    /// Applies all properties defined in this patch to <paramref name="original"/> using
    /// reflection, then returns a completed <see cref="ValueTask"/>.
    /// Throws <see cref="OperationCanceledException"/> if <paramref name="cancellationToken"/>
    /// is already cancelled before work begins.
    /// </summary>
    public ValueTask PatchAsync({{{qualifiedModelName}}} original, JsonSerializerOptions? options = null, CancellationToken cancellationToken = default)
    {
        cancellationToken.ThrowIfCancellationRequested();
        Patch(original, options);
        return ValueTask.CompletedTask;
    }

    private static PropertyInfo? FindProperty(string name) => FindMember(typeof({{{qualifiedModelName}}}), name)?.Property;

    /// <summary>
    /// Public instance properties of each patched type keyed by JSON wire name (case-insensitive),
    /// built once per type because reflection is slow on the PATCH hot path.
    /// </summary>
    private static readonly System.Collections.Concurrent.ConcurrentDictionary<Type, Dictionary<string, (PropertyInfo Property, string WireName)>> _typeProperties = new();

    private static (PropertyInfo Property, string WireName)? FindMember(Type type, string name) =>
        _typeProperties.GetOrAdd(type, BuildPropertyMap).TryGetValue(name, out var member) ? member : null;

    private static Dictionary<string, (PropertyInfo Property, string WireName)> BuildPropertyMap(Type type)
    {
        var map = new Dictionary<string, (PropertyInfo Property, string WireName)>(StringComparer.OrdinalIgnoreCase);
        foreach (var property in type.GetProperties(BindingFlags.Public | BindingFlags.Instance))
        {
            var wireName = property.GetCustomAttribute<JsonPropertyNameAttribute>()?.Name ?? property.Name;
            map.TryAdd(wireName, (property, wireName));
        }
        return map;
    }
}