{{!--
  validator-helpers.hbs — partial registered as `validatorHelpers`.

  Declares the private helper methods a generated validator needs after its
  constructor: `IsMatch` for `@pattern` rules, `TryGetNumber` (`decimal`) and
  `TryGetDouble` (floating-point properties) for numeric bounds in a MergePatch
  validator, and the API-version helpers of a
  version-aware validator. Include it on its own line inside the class body.
--}}
{{#if usesPatterns}}

/// <summary>
/// Returns <see langword="true"/> when <paramref name="value"/> is null or matches
/// <paramref name="pattern"/>. A match that times out counts as a mismatch.
/// </summary>
private static bool IsMatch(System.Text.RegularExpressions.Regex pattern, string? value)
{
    if (value is null) return true;
    try
    {
        return pattern.IsMatch(value);
    }
    catch (System.Text.RegularExpressions.RegexMatchTimeoutException)
    {
        return false;
    }
}
{{/if}}
{{#if usesNumberRules}}

/// <summary>
/// Reads the JSON number supplied for <paramref name="name"/>. Returns
/// <see langword="false"/> when the value is absent or is not a JSON number.
/// A number outside the <see cref="decimal"/> range is clamped to it, which keeps
/// every comparison with a bound correct.
/// </summary>
private static bool TryGetNumber({{{qualifiedPatchBodyTypeName}}} patch, string name, out decimal value)
{
    value = 0m;
    if (!patch.Properties.TryGetValue(name, out var element) || element.ValueKind != System.Text.Json.JsonValueKind.Number) return false;
    if (!element.TryGetDecimal(out value))
    {
        value = element.GetRawText().StartsWith('-') ? decimal.MinValue : decimal.MaxValue;
    }
    return true;
}
{{/if}}
{{#if usesDoubleRules}}

/// <summary>
/// Reads the JSON number supplied for <paramref name="name"/> as a <see cref="double"/>,
/// for the bounds of a floating-point property. Returns <see langword="false"/> when the
/// value is absent or is not a JSON number. A number outside the <see cref="double"/>
/// range is clamped to it, which keeps every comparison with a bound correct.
/// </summary>
private static bool TryGetDouble({{{qualifiedPatchBodyTypeName}}} patch, string name, out double value)
{
    value = 0d;
    if (!patch.Properties.TryGetValue(name, out var element) || element.ValueKind != System.Text.Json.JsonValueKind.Number) return false;
    if (!element.TryGetDouble(out value))
    {
        value = element.GetRawText().StartsWith('-') ? double.MinValue : double.MaxValue;
    }
    return true;
}
{{/if}}
{{#if allVersions}}

/// <summary>
/// Returns <see langword="true"/> when the request's API version is <paramref name="since"/>
/// or later, and earlier than <paramref name="until"/> when it is set.
/// </summary>
private bool IsVersionInRange(string since, string? until)
{
    var current = CurrentVersionIndex();
    return current >= System.Array.IndexOf(_versions, since)
        && (until is null || current < System.Array.IndexOf(_versions, until));
}

/// <summary>
/// Returns the position in <c>_versions</c> of the API version requested by the current
/// HTTP request. A request without a version uses {{{defaultVersion}}}; a version that
/// matches none of the known versions is validated against the latest one.
/// </summary>
private int CurrentVersionIndex()
{
    var requested = ResolveApiVersion(_httpContextAccessor.HttpContext);
    if (requested is null) return System.Array.IndexOf(_versions, "{{{defaultVersion}}}");
    var index = System.Array.IndexOf(_normalizedVersions, NormalizeVersion(requested));
    return index >= 0 ? index : _versions.Length - 1;
}

/// <summary>
/// Reads the API version from the <c>version</c> route value, the <c>api-version</c>
/// header, or the <c>api-version</c> query parameter, in that order.
/// </summary>
private static string? ResolveApiVersion(HttpContext? context)
{
    if (context is null) return null;
    if (context.Request.RouteValues.TryGetValue("version", out var rv) && rv is string rs && rs.Length > 0) return rs;
    if (context.Request.Headers.TryGetValue("api-version", out var hv) && hv.Count > 0 && !string.IsNullOrEmpty(hv[0])) return hv[0];
    if (context.Request.Query.TryGetValue("api-version", out var qv) && qv.Count > 0 && !string.IsNullOrEmpty(qv[0])) return qv[0];
    return null;
}

/// <summary>
/// Normalizes a version for comparison: case-insensitive, without a leading <c>v</c>
/// and without trailing <c>.0</c> parts, so <c>v2.0</c>, <c>V2</c> and <c>2.0</c> match.
/// </summary>
private static string NormalizeVersion(string version)
{
    var normalized = version.Trim().ToLowerInvariant();
    if (normalized.StartsWith('v')) normalized = normalized[1..];
    while (normalized.Length > 2 && normalized.EndsWith(".0", System.StringComparison.Ordinal)) normalized = normalized[..^2];
    return normalized;
}
{{/if}}
