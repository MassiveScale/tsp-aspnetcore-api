{{!--
  validator-merge-patch-property-rules.hbs — partial registered as `mergePatchPropertyRules`.

  Renders the rules for one property of a PATCH validator over a MergePatch
  body. The body holds the raw JSON, so each rule reads the value by name and
  fires only when the property is present (and, for value rules, not null).
  Included through the `propertyRules` partial.

  ── Template variables (one entry of `properties`) ──────────────────────────
  See "Validator view models" in docs/custom-templates.md.
--}}
{{#if isReadOnly}}
// {{{name}}} {{#if isImmutable}}cannot be changed after creation{{else}}is read-only and cannot be modified via patch{{/if}}
this.RuleFor(x => x)
    .Must(x => !x.IsDefined("{{{jsonName}}}"))
    .WithName("{{{name}}}")
    .WithMessage("'{{{name}}}' {{#if isImmutable}}cannot be changed after creation{{else}}is read-only and cannot be modified{{/if}}.");

{{else}}
{{#if rejectNull}}
// {{{name}}} is required and cannot be removed
this.RuleFor(x => x)
    .Must(x => !x.IsNull("{{{jsonName}}}"))
    .When(x => x.IsDefined("{{{jsonName}}}"))
    .WithName("{{{name}}}")
    .WithMessage("'{{{name}}}' is required and cannot be null.");

{{/if}}
{{#if validatesValueType}}
// {{{name}}} must hold a value of its declared type when provided
this.RuleFor(x => x)
    .Must(x => x.IsValidPropertyValue("{{{jsonName}}}"))
    .When(x => x.IsDefined("{{{jsonName}}}") && !x.IsNull("{{{jsonName}}}"))
    .WithName("{{{name}}}")
    .WithMessage("'{{{name}}}' is not a valid value.");

{{/if}}
{{!--
  String rules use the same FluentValidation validators as a POST validator, so
  both reject the same values with the same messages. They run only on a JSON
  string; any other value is reported once, by the type rule above.
--}}
{{#if notEmpty}}
// {{{name}}} must not be empty when provided
this.RuleFor(x => x.GetString("{{{jsonName}}}"))
    .NotEmpty()
    .OverridePropertyName("{{{name}}}")
    .WithName("{{{name}}}")
    .When(x => x.IsString("{{{jsonName}}}"));

{{/if}}
{{#if minLength}}
// {{{name}}} must be at least {{minLength}} characters when provided
this.RuleFor(x => x.GetString("{{{jsonName}}}"))
    .MinimumLength({{minLength}})
    .OverridePropertyName("{{{name}}}")
    .WithName("{{{name}}}")
    .When(x => x.IsString("{{{jsonName}}}"));

{{/if}}
{{!-- isDefined, not a plain #if: a zero maximum is still a limit. --}}
{{#if (isDefined maxLength)}}
// {{{name}}} cannot exceed a MaxLength of {{maxLength}} when provided
this.RuleFor(x => x.GetString("{{{jsonName}}}"))
    .MaximumLength({{maxLength}})
    .OverridePropertyName("{{{name}}}")
    .WithName("{{{name}}}")
    .When(x => x.IsString("{{{jsonName}}}"));

{{/if}}
{{#if pattern}}
// {{{name}}} must match the pattern '{{pattern}}' when provided
this.RuleFor(x => x.GetString("{{{jsonName}}}"))
    .Must(value => IsMatch({{{patternField}}}, value))
    .WithMessage("'{PropertyName}' is not in the correct format.")
    .OverridePropertyName("{{{name}}}")
    .WithName("{{{name}}}")
    .When(x => x.IsString("{{{jsonName}}}"));

{{/if}}
{{#if emailAddress}}
// {{{name}}} must be a valid email address when provided
this.RuleFor(x => x.GetString("{{{jsonName}}}"))
    .EmailAddress()
    .OverridePropertyName("{{{name}}}")
    .WithName("{{{name}}}")
    .When(x => x.IsString("{{{jsonName}}}"));

{{/if}}
{{!--
  Range rules run only on a value the type rule accepts, so a value that is not
  a number is reported once. That includes a number in a JSON string when the
  patch's JSON options or the property's own attributes let POST read it.
--}}
{{#if minValue}}
// {{{name}}} must be greater than or equal to {{minValue.display}} when provided
this.RuleFor(x => x)
    .Must(x => {{{minValue.patchReader}}}(x, "{{{jsonName}}}", out var n) && n >= {{{minValue.patchLiteral}}})
    .When(x => x.IsDefined("{{{jsonName}}}") && !x.IsNull("{{{jsonName}}}") && x.IsValidPropertyValue("{{{jsonName}}}"))
    .WithName("{{{name}}}")
    .WithMessage("'{{{name}}}' must be a number greater than or equal to {{minValue.display}}.");

{{/if}}
{{#if minValueExclusive}}
// {{{name}}} must be greater than {{minValueExclusive.display}} when provided
this.RuleFor(x => x)
    .Must(x => {{{minValueExclusive.patchReader}}}(x, "{{{jsonName}}}", out var n) && n > {{{minValueExclusive.patchLiteral}}})
    .When(x => x.IsDefined("{{{jsonName}}}") && !x.IsNull("{{{jsonName}}}") && x.IsValidPropertyValue("{{{jsonName}}}"))
    .WithName("{{{name}}}")
    .WithMessage("'{{{name}}}' must be a number greater than {{minValueExclusive.display}}.");

{{/if}}
{{#if maxValue}}
// {{{name}}} cannot exceed a MaxValue of {{maxValue.display}} when provided
this.RuleFor(x => x)
    .Must(x => {{{maxValue.patchReader}}}(x, "{{{jsonName}}}", out var n) && n <= {{{maxValue.patchLiteral}}})
    .When(x => x.IsDefined("{{{jsonName}}}") && !x.IsNull("{{{jsonName}}}") && x.IsValidPropertyValue("{{{jsonName}}}"))
    .WithName("{{{name}}}")
    .WithMessage("'{{{name}}}' must be a number less than or equal to {{maxValue.display}}.");

{{/if}}
{{#if maxValueExclusive}}
// {{{name}}} must be less than {{maxValueExclusive.display}} when provided
this.RuleFor(x => x)
    .Must(x => {{{maxValueExclusive.patchReader}}}(x, "{{{jsonName}}}", out var n) && n < {{{maxValueExclusive.patchLiteral}}})
    .When(x => x.IsDefined("{{{jsonName}}}") && !x.IsNull("{{{jsonName}}}") && x.IsValidPropertyValue("{{{jsonName}}}"))
    .WithName("{{{name}}}")
    .WithMessage("'{{{name}}}' must be a number less than {{maxValueExclusive.display}}.");

{{/if}}
{{#if minItems}}
// {{{name}}} must contain at least {{minItems}} items when provided
this.RuleFor(x => x)
    .Must(x => x.Properties.TryGetValue("{{{jsonName}}}", out var items) && items.ValueKind == System.Text.Json.JsonValueKind.Array && items.GetArrayLength() >= {{minItems}})
    .When(x => x.IsDefined("{{{jsonName}}}") && !x.IsNull("{{{jsonName}}}"))
    .WithName("{{{name}}}")
    .WithMessage("'{{{name}}}' must be an array with at least {{minItems}} items.");

{{/if}}
{{#if (isDefined maxItems)}}
// {{{name}}} cannot contain more than {{maxItems}} items when provided
this.RuleFor(x => x)
    .Must(x => x.Properties.TryGetValue("{{{jsonName}}}", out var items) && items.ValueKind == System.Text.Json.JsonValueKind.Array && items.GetArrayLength() <= {{maxItems}})
    .When(x => x.IsDefined("{{{jsonName}}}") && !x.IsNull("{{{jsonName}}}"))
    .WithName("{{{name}}}")
    .WithMessage("'{{{name}}}' must be an array with no more than {{maxItems}} items.");

{{/if}}
{{#if referencedModelName}}
{{> mergePatchNestedRules}}

{{/if}}
{{/if}}
