{{!--
  validator-merge-patch-nested.hbs — partial registered as `mergePatchNestedRules`.

  Renders the rule that validates a model-typed property of a MergePatch body.
  Used by the `mergePatchPropertyRules` partial; custom PATCH validator
  templates can include it with `{{> mergePatchNestedRules}}`.
  When included on its own line, every rendered line gets that line's indent.

  ── Template variables (one entry of `properties`) ──────────────────────────
  name                          — Wire/C# property name (e.g. "Appearance")
  isCollectionReference         — True for an array of models
  isRecordReference             — True for a Record of models
  isReplacedReference           — True for a model the patch replaces instead of
                                  merging into (`@patchStrategy("replace")`)
  referencedQualifiedModelName  — Model type used to deserialize array items and
                                  replaced values
  mergePatchValidatorExpression — C# expression for the nested validator: a
                                  constructor parameter, `this`, or a lazy lookup
  mergePatchFactoryTypeName     — Patch type whose FromJson builds the nested patch

  The enclosing constructor must declare `jsonSerializerOptions`.
--}}
{{#if isCollectionReference}}
// {{{name}}} replaces the whole array, so each item is validated as a complete model
this.RuleFor(x => x).Custom((patch, context) =>
{
    if (!patch.Properties.TryGetValue("{{{jsonName}}}", out var element) || element.ValueKind == System.Text.Json.JsonValueKind.Null) return;
    if (element.ValueKind != System.Text.Json.JsonValueKind.Array)
    {
        context.AddFailure("{{{name}}}", "'{{{name}}}' must be an array.");
        return;
    }
    var index = 0;
    foreach (var item in element.EnumerateArray())
    {
        if (item.ValueKind != System.Text.Json.JsonValueKind.Object)
        {
            context.AddFailure($"{{{name}}}[{index}]", "Array items must be objects.");
            index++;
            continue;
        }
        // A failure names the member, item or entry that did not fit, such as {{{name}}}[0].Code.
        if (!patch.TryReadValue<{{{referencedQualifiedModelName}}}>(item, $"{{{name}}}[{index}]", out var nestedModel, out var errorPath, out var errorMessage, jsonSerializerOptions))
        {
            context.AddFailure(errorPath, errorMessage);
            index++;
            continue;
        }
        if (nestedModel is null)
        {
            context.AddFailure($"{{{name}}}[{index}]", "Array items must be objects.");
        }
        else
        {
            var nestedResult = {{{mergePatchValidatorExpression}}}.Validate(nestedModel);
            foreach (var failure in nestedResult.Errors)
                context.AddFailure($"{{{name}}}[{index}].{failure.PropertyName}", failure.ErrorMessage);
        }
        index++;
    }
});
{{else if isRecordReference}}
// {{{name}}} is merged key by key, so each supplied value is validated as a nested patch
this.RuleFor(x => x).Custom((patch, context) =>
{
    if (!patch.Properties.TryGetValue("{{{jsonName}}}", out var element) || element.ValueKind == System.Text.Json.JsonValueKind.Null) return;
    if (element.ValueKind != System.Text.Json.JsonValueKind.Object)
    {
        context.AddFailure("{{{name}}}", "'{{{name}}}' must be an object.");
        return;
    }
    foreach (var entry in element.EnumerateObject())
    {
        // A null value removes the entry.
        if (entry.Value.ValueKind == System.Text.Json.JsonValueKind.Null) continue;
        if (entry.Value.ValueKind != System.Text.Json.JsonValueKind.Object)
        {
            context.AddFailure($"{{{name}}}[{entry.Name}]", "Values must be objects.");
            continue;
        }
        var nestedPatch = {{{mergePatchFactoryTypeName}}}.FromJson(entry.Value.GetRawText(), jsonSerializerOptions);
{{#if mergePatchDiscriminatorName}}
        if (!nestedPatch.IsDefined({{csharpString mergePatchDiscriminatorName}}))
        {
            context.AddFailure($"{{{name}}}[{entry.Name}]." + {{csharpString mergePatchDiscriminatorName}}, "The discriminator is required.");
            continue;
        }
{{/if}}
        var nestedResult = {{{mergePatchValidatorExpression}}}.Validate(nestedPatch);
        foreach (var failure in nestedResult.Errors)
            context.AddFailure($"{{{name}}}[{entry.Name}].{failure.PropertyName}", failure.ErrorMessage);
    }
});
{{else if isReplacedReference}}
// {{{name}}} replaces the existing value, so it is validated as a complete model
this.RuleFor(x => x).Custom((patch, context) =>
{
    if (!patch.Properties.TryGetValue("{{{jsonName}}}", out var element) || element.ValueKind == System.Text.Json.JsonValueKind.Null) return;
    if (element.ValueKind != System.Text.Json.JsonValueKind.Object)
    {
        context.AddFailure("{{{name}}}", "'{{{name}}}' must be an object.");
        return;
    }
    // A failure names the member that did not fit, such as {{{name}}}.Code, or {{{name}}} itself.
    if (!patch.TryReadValue<{{{referencedQualifiedModelName}}}>(element, "{{{name}}}", out var nestedModel, out var errorPath, out var errorMessage, jsonSerializerOptions))
    {
        context.AddFailure(errorPath, errorMessage);
        return;
    }
    if (nestedModel is null)
    {
        context.AddFailure("{{{name}}}", "'{{{name}}}' must be an object.");
        return;
    }
    var nestedResult = {{{mergePatchValidatorExpression}}}.Validate(nestedModel);
    foreach (var failure in nestedResult.Errors)
        context.AddFailure($"{{{name}}}.{failure.PropertyName}", failure.ErrorMessage);
});
{{else}}
// {{{name}}} is merged into the existing value, so it is validated as a nested patch
this.RuleFor(x => x).Custom((patch, context) =>
{
    if (!patch.Properties.TryGetValue("{{{jsonName}}}", out var element) || element.ValueKind == System.Text.Json.JsonValueKind.Null) return;
    if (element.ValueKind != System.Text.Json.JsonValueKind.Object)
    {
        context.AddFailure("{{{name}}}", "'{{{name}}}' must be an object.");
        return;
    }
    var nestedPatch = {{{mergePatchFactoryTypeName}}}.FromJson(element.GetRawText(), jsonSerializerOptions);
{{#if mergePatchDiscriminatorName}}
    if (!nestedPatch.IsDefined({{csharpString mergePatchDiscriminatorName}}))
    {
        context.AddFailure("{{{name}}}." + {{csharpString mergePatchDiscriminatorName}}, "The discriminator is required.");
        return;
    }
{{/if}}
    var nestedResult = {{{mergePatchValidatorExpression}}}.Validate(nestedPatch);
    foreach (var failure in nestedResult.Errors)
        context.AddFailure($"{{{name}}}.{failure.PropertyName}", failure.ErrorMessage);
});
{{/if}}
